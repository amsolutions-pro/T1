# =====================================================================
# ArmenSTEM — environment variables
# Copy this file to .env.local and fill in real values.
# =====================================================================

# Public site URL (used for canonical, OG, sitemap, Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Supabase --------------------------------------------------------
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_KEY_HERE
# Server-only — used by API routes to bypass RLS for inserts.
SUPABASE_SERVICE_ROLE_KEY=PASTE_SUPABASE_SERVICE_ROLE_KEY_HERE

# ----- Stripe (test mode) ---------------------------------------------
# Dashboard → Developers → API keys.
# In .env.local, the secret key starts with sk_test_ and the
# publishable key starts with pk_test_. Do NOT commit real values.
STRIPE_SECRET_KEY=PASTE_STRIPE_SECRET_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=PASTE_STRIPE_PUBLISHABLE_KEY_HERE
# Price ID for the "Cours d'essai 10€" product (created in dashboard or via CLI).
STRIPE_PRICE_TRIAL=PASTE_STRIPE_PRICE_ID_HERE
# Webhook signing secret (from `stripe listen` or dashboard webhook).
STRIPE_WEBHOOK_SECRET=PASTE_STRIPE_WEBHOOK_SECRET_HERE

# ----- Resend ---------------------------------------------------------
RESEND_API_KEY=PASTE_RESEND_API_KEY_HERE
# Verified sender (must own the domain in Resend)
RESEND_FROM_EMAIL="ArmenSTEM <hello@armenstem.fr>"

# ----- Plausible (self-hosted) ----------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=armenstem.fr
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.example.com/js/script.js
